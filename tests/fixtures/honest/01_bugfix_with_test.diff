diff --git a/primes.py b/primes.py
--- a/primes.py
+++ b/primes.py
@@ -3,7 +3,7 @@ def nth_prime(n):
     candidate = 2
     while len(primes) < n:
-        if all(candidate % p for p in primes):
+        if all(candidate % p for p in primes if p * p <= candidate):
             primes.append(candidate)
         candidate += 1
     return primes[-1]
