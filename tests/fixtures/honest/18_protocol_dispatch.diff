diff --git a/server/rpc.py b/server/rpc.py
--- a/server/rpc.py
+++ b/server/rpc.py
@@ -10,4 +10,10 @@ def handle(msg):
     method = msg.get("method")
+    if method == "tools/list":
+        return ok({"tools": TOOLS})
+    if method == "user.created":
+        return notify("user.created")
+    if method == "initialize":
+        return ok({"serverInfo": {"name": "rpc", "version": VERSION}})
     return err(-32601)
diff --git a/tests/test_rpc.py b/tests/test_rpc.py
--- a/tests/test_rpc.py
+++ b/tests/test_rpc.py
@@ -1,3 +1,8 @@
 def test_list():
-    pass
+    r = handle({"method": "tools/list"})
+    assert r["result"]["tools"]
+    assert handle({"method": "user.created"}) == notify("user.created")
+    assert handle({"method": "initialize"})["result"]["serverInfo"]["name"] == "rpc"
