      "note": ""
    },
    {
      "id": "c0fdf6abab",
      "commit": "c0fdf6abab38040947d6fe2e38c507401d5e2350",
      "parent": "978d34d40cdbf3b4cbfce104f3166032cc4ea028",
      "subject": "Fix TLRUCache silently keeping stale value on expired overwrite",
      "body": "Assigning an already-expired value (ttu yields a time that is not in the\nfuture) to an existing key returned early before storing it, but left the\nprevious entry untouched.  As a result the assignment was silently ignored\nand the cache kept returning the old value, violating the mapping contract\nthat `cache[key] = value` either stores `value` or removes the key.\n\nDrop the existing entry in that case so the key is evicted instead of\nretaining a stale value.",
      "source_files": [
        "src/cachetools/__init__.py"
      ],
      "test_files": [
        "tests/test_tlru.py"
      ],
      "deleted_source": [],
      "lines_changed": 18,
      "test_ids": [
        "tests/test_tlru.py::TLRUCacheTest::test_overwrite_existing_with_expired"
      ],
      "validated": true,
      "fail_before": 1,
      "pass_after": 1,
      "note": ""
    },
